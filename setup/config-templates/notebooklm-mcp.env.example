# NotebookLM MCP (Pantheon Security) — Environment Variables
# Only GEMINI_API_KEY is needed for basic use. Everything else has sane defaults.

# Required for AI features (Deep Research, Document tools)
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Auth (auto-generated during setup — do not edit manually)
NLMCP_AUTH_ENABLED=true
NLMCP_AUTH_TOKEN=AUTO_GENERATED

# Optional: browser behavior
HEADLESS=true
BROWSER_TIMEOUT=30000

# Optional: model selection
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Optional: stealth (leave defaults)
STEALTH_ENABLED=true
STEALTH_RANDOM_DELAYS=true
STEALTH_HUMAN_TYPING=true
