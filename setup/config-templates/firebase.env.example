# Firebase AI Logic / Gemini API Configuration
# NO Vertex AI — all media gen uses GEMINI_API_KEY (free tier)
# Artifacts save LOCALLY so you keep them when trial ends

# ── Core API Key ──────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Firebase Project (for Storage / Firestore persistence) ─
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_API_KEY=your-firebase-web-api-key

# ── Local Output Directories ─────────────────────────────
# All generated assets save here — YOU keep these files
OUTPUT_DIR_IMAGES=./generated/images
OUTPUT_DIR_VIDEO=./generated/video
OUTPUT_DIR_MUSIC=./generated/music
OUTPUT_DIR_TTS=./generated/tts
OUTPUT_DIR_AV=./generated/av
OUTPUT_DIR_STORYBOARD=./generated/storyboards
OUTPUT_DIR_AUDIOBOOK=./generated/audiobooks

# ── Model Selection ───────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash
IMAGEN_MODEL=imagen-3.0-generate-001
VEO_MODEL=veo-3.1
CHIRP_MODEL=chirp-3-hd
LYRIA_MODEL=lyria-2

# ── Discord Bot (see setup/discord-bot/) ──────────────────
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-guild-id
DISCORD_WHISPER_CHANNEL_ID=your-whisper-channel-id

# ── Whisper (local speech-to-text) ────────────────────────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# Set to "cuda" if you have GPU (GTX 1080+)
