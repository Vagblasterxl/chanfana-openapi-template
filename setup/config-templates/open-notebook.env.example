# open-notebook — Self-hosted NotebookLM Alternative
# Only ENCRYPTION_KEY is required. AI keys configured via web UI after startup.

# REQUIRED — encrypt API credentials in database (min 16 chars)
OPEN_NOTEBOOK_ENCRYPTION_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_STRING

# Database (defaults work with docker-compose)
SURREAL_URL=ws://surrealdb:8000/rpc
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

# Optional: Ollama local AI (if running on GTX 1080 machine)
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: Cloud AI keys (easier to set via web UI at http://localhost:8502)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
