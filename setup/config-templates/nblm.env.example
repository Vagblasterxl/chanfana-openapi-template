# nblm CLI — NotebookLM Enterprise API Client
# Requires: Google Cloud project with NotebookLM Enterprise API enabled + gcloud CLI

# REQUIRED — your GCP project NUMBER (not ID)
# Get it: gcloud projects describe YOUR_PROJECT_ID --format="value(projectNumber)"
NBLM_PROJECT_NUMBER=PASTE_YOUR_PROJECT_NUMBER_HERE

# Region (global works for most)
NBLM_LOCATION=global
NBLM_ENDPOINT_LOCATION=global
