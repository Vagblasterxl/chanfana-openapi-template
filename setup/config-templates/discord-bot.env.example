# Discord Bot — 8 AI Slots + 1 Human + Whisper Channel
# Pipeline: Go Discord Bot → Gemini API → Firebase Storage

# ── Discord Auth ──────────────────────────────────────────
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_APPLICATION_ID=your-app-id
DISCORD_GUILD_ID=your-guild-id

# ── Channel IDs ───────────────────────────────────────────
# Whisper channel — voice-to-text transcription
DISCORD_WHISPER_CHANNEL_ID=your-whisper-channel-id
# Main production channel
DISCORD_MAIN_CHANNEL_ID=your-main-channel-id
# Audiobook output channel
DISCORD_AUDIOBOOK_CHANNEL_ID=your-audiobook-channel-id
# Storyboard gallery channel
DISCORD_STORYBOARD_CHANNEL_ID=your-storyboard-channel-id

# ── AI Backend (Firebase/Gemini — NOT Vertex) ─────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ── Whisper Config ────────────────────────────────────────
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=en
WHISPER_DEVICE=cpu

# ── Asset Persistence ─────────────────────────────────────
# Local dir for all generated assets (you keep these)
LOCAL_ASSET_DIR=./generated
# Optional Firebase Storage backup
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
