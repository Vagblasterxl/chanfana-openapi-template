# Vertex AI Creative Studio MCP — Environment Variables
# Requires: Google Cloud project with Vertex AI API enabled
# Auth: gcloud auth application-default login (run once)

# REQUIRED — your GCP project ID (not number)
PROJECT_ID=PASTE_YOUR_GCP_PROJECT_ID_HERE

# Region for Vertex AI API calls
LOCATION=us-central1

# GCS bucket for storing generated media
# Create: gsutil mb -l us-central1 gs://your-bucket-name
GENMEDIA_BUCKET=PASTE_YOUR_GCS_BUCKET_NAME_HERE

# MCP server timeout (ms) — video/music generation can take 30-60s
MCP_SERVER_REQUEST_TIMEOUT=55000
