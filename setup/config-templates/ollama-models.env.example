# Ollama Local AI — Model Configuration
# For metadata extraction, prompt refinement, and text tasks
# Hardware: GTX 1080 (8GB VRAM) — use 7-8B parameter models

# Base URL
OLLAMA_BASE_URL=http://localhost:11434

# Models pulled during setup
OLLAMA_MODELS=mistral:7b,llama3.1:8b

# Default model for metadata extraction (tags, descriptions, alt text)
OLLAMA_METADATA_MODEL=mistral:7b

# Default model for prompt refinement (expanding vague prompts)
OLLAMA_PROMPT_MODEL=mistral:7b
