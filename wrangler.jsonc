{
  "compatibility_date": "2025-10-08",
  "main": "src/index.ts",
  "name": "chanfana-openapi-template",
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openapi-template-db",
      "database_id": "b96d67ac-a912-4416-9a47-770c627c088b"
    }
  ],
  // Secrets (set via wrangler secret put):
  //   GOOGLE_SERVICE_ACCOUNT — Google Service Account JSON key (Sheets, Drive, Calendar, Gmail, Firestore)
  //   GITHUB_TOKEN           — GitHub Personal Access Token (repo scope)
  "vars": {
    "FIREBASE_PROJECT_ID": "YOUR_FIREBASE_PROJECT_ID"
  }
}
