{
  "compatibility_date": "2025-10-08",
  "main": "src/index.ts",
  "name": "chanfana-openapi-template",
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openapi-template-db",
      // Verified 2026-07-08: this is the real openapi-template-db on the
      // Vagblasterxl@gmail.com account (9e6e291db1bc4c877db80a30ff15e92c).
      // Migrations 0001-0005 are applied. Deploy target = that account.
      "database_id": "d7b93547-6fba-4766-afb3-7e39e6e36219"
    }
  ],
  // R2 is NOT enabled on the Vagblasterxl account (and enabling it is what
  // triggers Cloudflare's billing prompt). The /sync/* endpoints detect the
  // missing binding and return a clean 501 — everything else works without it.
  // To re-enable later: enable R2 in the dashboard, create the bucket, then
  // uncomment this block.
  // "r2_buckets": [
  //   {
  //     "binding": "R2_BUCKET",
  //     "bucket_name": "coordination-sync-ken"
  //   }
  // ],
  // API_KEY is the shared dev/test token (the vitest suite uses this exact value).
  // Before any real deployment, rotate it to a strong secret: wrangler secret put API_KEY
  //
  // MEM_API_KEY is a REAL third-party credential and must NOT be hardcoded here.
  //   Local dev:  put it in .dev.vars (gitignored — see .dev.vars.example)
  //   Production: npx wrangler secret put MEM_API_KEY
  "vars": {
    "API_KEY": "symphony-ken-2026"
  }
}
