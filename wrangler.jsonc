{
  "compatibility_date": "2025-10-08",
  "main": "src/index.ts",
  "name": "chanfana-openapi-template",
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openapi-template-db",
      "database_id": "b96d67ac-a912-4416-9a47-770c627c088b"
    }
  ],
  // R2 bucket for coordination file sync between workers
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "coordination-sync-ken"
    }
  ],
  // Symphony API key for coordination endpoint auth
  // MEM_API_KEY is set as a secret via: wrangler secret put MEM_API_KEY
  "vars": {
    "API_KEY": "symphony-ken-2026",
    "MEM_API_KEY": "sk-mem-ca1e8ba9-c285-4e70-a582-ced1b5aa0d3a"
  }
}
