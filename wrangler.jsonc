{
  "compatibility_date": "2025-10-08",
  "main": "src/index.ts",
  "name": "chanfana-openapi-template",
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openapi-template-db",
      "database_id": "b96d67ac-a912-4416-9a47-770c627c088b"
    }
  ],
  // R2 bucket for coordination file sync between workers
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "coordination-sync-ken"
    }
  ],
  // API_KEY is the shared dev/test token (the vitest suite uses this exact value).
  // Before any real deployment, rotate it to a strong secret: wrangler secret put API_KEY
  //
  // MEM_API_KEY is a REAL third-party credential and must NOT be hardcoded here.
  //   Local dev:  put it in .dev.vars (gitignored — see .dev.vars.example)
  //   Production: npx wrangler secret put MEM_API_KEY
  "vars": {
    "API_KEY": "symphony-ken-2026"
  }
}
